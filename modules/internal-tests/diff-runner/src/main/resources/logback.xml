<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%msg%n</pattern>
        </encoder>
    </appender>
    <!-- diff-runner output goes through System.out (not the logger), so
         keep the logger threshold high to suppress noise from grpc/netty. -->
    <root level="WARN">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
